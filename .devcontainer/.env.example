# Vorlage fuer .devcontainer/.env  — NICHT den echten Token committen!
#
# 1. Auf dem HOST (mit Browser) einmalig ausfuehren:
#      claude setup-token
#    Der OAuth-Flow oeffnet den Browser; danach wird ein langlebiger
#    Token (sk-ant-oat01-..., ~12 Monate) EINMALIG ausgegeben.
#
# 2. Diese Datei nach .devcontainer/.env kopieren und den Wert eintragen:
#      cp .devcontainer/.env.example .devcontainer/.env
#
# 3. Container (neu) starten: dvc up   bzw.   dvc re
#
# Setzt Pro/Max/Team/Enterprise-Abo voraus. Token laeuft nach ~12 Monaten
# aus bzw. wenn Claude wieder nach Login fragt -> setup-token erneut ausfuehren.

CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME
