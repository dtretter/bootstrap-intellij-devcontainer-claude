#!/usr/bin/env bash
set -euo pipefail

# Neuere Compose-Versionen bauen immer per buildx bake (COMPOSE_BAKE=false wird ignoriert);
# bake verweigert das Dockerfile-with-features der devcontainer-CLI (liegt in /tmp,
# außerhalb des Build-Kontexts) ohne --allow=fs.read. Die fs-Entitlement-Prüfung von bake
# abschalten; per BUILDX_BAKE_ENTITLEMENTS_FS=1 in der Umgebung überschreibbar.
export BUILDX_BAKE_ENTITLEMENTS_FS="${BUILDX_BAKE_ENTITLEMENTS_FS:-0}"

usage() {
  cat <<'USAGE'
dvc — Kurzbefehle für die devcontainer-CLI im aktuellen Verzeichnis

Verwendung:
  dvc [-c NAME] <cmd>  -c NAME: Konfiguration .devcontainer/NAME/devcontainer.json
                       statt .devcontainer/devcontainer.json (z. B. -c https);
                       -c default erzwingt die Standardkonfiguration.
                       Vorgabe ohne -c: Umgebungsvariable DVC_CONFIG, sonst "https"
                       (fehlt die Konfiguration im Projekt, gilt die Standardkonfiguration).

  dvc up [ARGS...]     Container starten (devcontainer up --workspace-folder .)
  dvc sh [ARGS...]     Bash-Shell im laufenden Container öffnen
  dvc re               Container neu bauen (--remove-existing-container)
  dvc stop             Alle Container (inkl. Compose-Services) zum aktuellen Verzeichnis stoppen
  dvc rm [-y|--yes]    Alle Container stoppen und entfernen (mit Rückfrage, Volumes bleiben)
  dvc help             Diese Hilfe anzeigen
  dvc <cmd> [ARGS...]  Beliebiger devcontainer-Befehl, --workspace-folder . wird ergänzt

Beispiele:
  dvc up --log-level debug
  dvc sh -c 'mvn -v'
  dvc exec mvn test
  dvc -c default re
  DVC_CONFIG=default dvc sh
USAGE
}

# Konfigurationsauswahl: -c NAME vor dem Befehl, sonst Vorgabe aus DVC_CONFIG, sonst
# "https". NAME steht fuer .devcontainer/NAME/devcontainer.json, "default" fuer
# .devcontainer/devcontainer.json. Fehlt die Vorgabe im Projekt, gilt still die
# Standardkonfiguration; fehlt eine ausdruecklich per -c verlangte, bricht dvc ab. Die
# devcontainer-CLI findet einen laufenden Container ueber Ordner UND Konfigurationsdatei -
# daher gilt --config fuer alle devcontainer-Befehle, nicht nur fuer up/re.
config_name="${DVC_CONFIG-https}"
config_explicit=0
if [ "${1-}" = "-c" ] || [ "${1-}" = "--config" ]; then
  if [ -z "${2-}" ]; then
    echo "dvc: $1 braucht einen Konfigurationsnamen (z. B. https, default)" >&2
    exit 1
  fi
  config_name="$2"
  config_explicit=1
  shift 2
fi

# Expansion als ${config_args[@]+"${config_args[@]}"}: bash < 4.4 (macOS: 3.2) meldet
# bei leerem Array unter set -u sonst "unbound variable".
config_args=()
if [ -n "$config_name" ] && [ "$config_name" != "default" ]; then
  config_file=".devcontainer/$config_name/devcontainer.json"
  if [ -f "$config_file" ]; then
    config_args=(--config "$config_file")
  elif [ "$config_explicit" -eq 1 ]; then
    echo "dvc: $config_file nicht gefunden" >&2
    exit 1
  fi
fi

# docker ps (mit den übergebenen Argumenten) über alle Container zum aktuellen Verzeichnis.
# Das devcontainer-Label trägt nur der Haupt-Service; weitere Compose-Services (DB, Mail, …)
# werden über das Compose-Projekt-Label des Haupt-Containers gefunden. Auch ein bereits
# gestoppter Haupt-Container zählt, damit noch laufende Sidecars erfasst werden.
# Unabhängig von der Konfigurationsauswahl: erfasst Container aller Konfigurationen.
project_ps() {
  local folder_filter="label=devcontainer.local_folder=$(pwd)" main_ids project
  main_ids="$(docker ps -aq --filter "$folder_filter")"
  {
    docker ps "$@" --filter "$folder_filter"
    if [ -n "$main_ids" ]; then
      for project in $(docker inspect \
          --format '{{index .Config.Labels "com.docker.compose.project"}}' $main_ids | sort -u); do
        docker ps "$@" --filter "label=com.docker.compose.project=$project"
      done
    fi
  } | sort -u
}

case "${1-}" in
  ""|help|-h|--help)  usage ;;
  up)   devcontainer up --workspace-folder . ${config_args[@]+"${config_args[@]}"} "${@:2}" ;;
  sh)   devcontainer exec --workspace-folder . ${config_args[@]+"${config_args[@]}"} bash "${@:2}" ;;
  re)   devcontainer up --workspace-folder . ${config_args[@]+"${config_args[@]}"} --remove-existing-container ;;
  stop)
    ids="$(project_ps -q)"
    if [ -z "$ids" ]; then
      echo "dvc: kein laufender Container für $(pwd)" >&2
      exit 1
    fi
    docker stop $ids
    ;;
  rm)
    assume_yes=0
    case "${2-}" in
      -y|--yes) assume_yes=1 ;;
    esac

    ids="$(project_ps -aq)"
    if [ -z "$ids" ]; then
      echo "dvc: kein Container für $(pwd)" >&2
      exit 1
    fi

    if [ "$assume_yes" -ne 1 ]; then
      project_ps -a --format '  {{.Names}}  ({{.Status}})'
      printf 'Container wirklich entfernen? Rebuild kann dauern. [y/N] '
      read -r answer
      case "$answer" in
        y|Y|yes|Yes) ;;
        *) echo "dvc: abgebrochen"; exit 0 ;;
      esac
    fi

    docker rm -f $ids
    ;;
  # Optionen direkt hinter den Unterbefehl: bei exec/run-user-commands o. ä. gehört alles
  # nach dem auszuführenden Befehl diesem Befehl, nicht der devcontainer-CLI.
  *)    devcontainer "$1" --workspace-folder . ${config_args[@]+"${config_args[@]}"} "${@:2}" ;;
esac
